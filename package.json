{
  "name": "paypace",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@supabase/supabase-js": "^2.116.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.24",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:shared && npm run test:control && npm run test:sync && npm run test:status && npm run test:pace && npm run test:range",
    "test:shared": "node --experimental-strip-types scripts/sharedBudget.e2e.mts",
    "test:control": "node --experimental-strip-types scripts/controlPanel.test.mts",
    "test:sync": "node --experimental-strip-types scripts/householdSync.test.mts",
    "test:status": "node --experimental-strip-types scripts/moneyStatus.test.mts",
    "test:pace": "node --experimental-strip-types scripts/dayPace.test.mts",
    "test:range": "node --experimental-strip-types scripts/availableRange.test.mts",
    "postinstall": "patch-package",
    "build:ios": "EAS_BUILD_NO_EXPO_GO_WARNING=true npx eas-cli build --platform ios --profile production",
    "build:ios:local": "EAS_BUILD_NO_EXPO_GO_WARNING=true npx eas-cli build --platform ios --profile production --local",
    "build:ios:local:submit": "bash scripts/build-ios-local.sh",
    "submit:ios": "npx eas-cli submit --platform ios --profile production --latest",
    "build:ios:submit": "EAS_BUILD_NO_EXPO_GO_WARNING=true npx eas-cli build --platform ios --profile production --auto-submit"
  },
  "private": true
}
