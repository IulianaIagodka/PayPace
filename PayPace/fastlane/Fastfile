# frozen_string_literal: true

default_platform(:ios)

platform :ios do
  desc "Bump build number from latest TestFlight (or local +1)"
  lane :bump_build do
    api_key = app_store_connect_api_key_from_env

    if api_key
      latest = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: ENV.fetch("APP_IDENTIFIER", "app.paypace.PayPace"),
        initial_build_number: 0
      )
      increment_build_number(
        build_number: latest + 1,
        xcodeproj: "PayPace.xcodeproj"
      )
    else
      increment_build_number(xcodeproj: "PayPace.xcodeproj")
    end
  end

  desc "Build signed IPA for App Store / TestFlight"
  lane :build_beta do
    setup_ci if ENV["CI"]

    unless ENV["DEVELOPMENT_TEAM"].to_s.empty?
      update_code_signing_settings(
        use_automatic_signing: true,
        path: "PayPace.xcodeproj",
        team_id: ENV["DEVELOPMENT_TEAM"],
        targets: ["PayPace"]
      )
    end

    bump_build

    build_app(
      project: "PayPace.xcodeproj",
      scheme: "PayPace",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "PayPace.ipa",
      include_bitcode: false,
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('DEVELOPMENT_TEAM', '')}",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        uploadSymbols: true
      }
    )
  end

  desc "Upload IPA to TestFlight"
  lane :upload_testflight do
    api_key = app_store_connect_api_key_from_env
    UI.user_error!("Missing App Store Connect API key env vars") unless api_key

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/PayPace.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "PayPace beta build")
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build_beta
    upload_testflight
  end

  desc "Archive locally without upload (produces build/PayPace.ipa)"
  lane :ipa do
    build_beta
  end

  private_lane :app_store_connect_api_key_from_env do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
    key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]

    next nil if key_id.to_s.empty? || issuer_id.to_s.empty?
    next nil if key_content.to_s.empty? && key_path.to_s.empty?

    args = {
      key_id: key_id,
      issuer_id: issuer_id,
      duration: 1200,
      in_house: false
    }

    if key_path && !key_path.empty? && File.exist?(key_path)
      args[:key_filepath] = key_path
    else
      # Support base64 or raw PEM content from CI secrets
      content = key_content
      if content.include?("BEGIN PRIVATE KEY")
        args[:key_content] = content
      else
        args[:key_content] = content
        args[:is_key_content_base64] = true
      end
    end

    app_store_connect_api_key(**args)
  end
end
